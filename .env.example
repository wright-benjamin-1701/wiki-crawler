# wiki-dumps configuration — copy to .env and edit as needed

# Tracking DB (extraction_runs provenance). Must be sqlite or postgresql.
# DATABASE_URL=sqlite:///data/databases/wiki.db

# Directory for downloaded Wikipedia dumps
# WIKI_DUMP_DIR=data/dumps

# Wikipedia language edition (default for `wiki dump *` commands)
# WIKI_LANG=en

# Default parallel worker processes for `wiki extract run` (-1 = all cores)
# WIKI_N_JOBS=-1
